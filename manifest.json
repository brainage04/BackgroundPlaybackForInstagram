{
  "manifest_version": 3,
  "name": "Instagram Background Playback",
  "version": "1.3.0",
  "description": "Keeps Instagram videos playing in background tabs, with sound on and X-style player controls.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/keep-visible.js", "src/media-source-registry.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/player-controls.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
