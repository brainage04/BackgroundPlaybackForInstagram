{
  "manifest_version": 3,
  "name": "Instagram Background Playback",
  "version": "1.1.0",
  "description": "Keeps Instagram videos playing when you switch tabs or windows, and adds a seek bar.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/keep-visible.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["src/seek-controls.js"],
      "run_at": "document_idle"
    }
  ]
}
